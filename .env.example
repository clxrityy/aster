# Copy to .env and supply your own values. Never commit .env.
# For native startup, use a PostgreSQL URL with a URL-encoded password.
DATABASE_URL=
# Docker Compose constructs the container database URL from this password.
# Use at least 32 random hexadecimal characters so URL encoding is unnecessary.
POSTGRES_PASSWORD=
# Generate a 64-character random hexadecimal token (32 random bytes).
ASTER_OWNER_TOKEN=
ASTER_BIND_ADDR=127.0.0.1:3000
# Non-loopback native binding requires explicit opt-in and a TLS boundary.
ASTER_ALLOW_REMOTE=false
RUST_LOG=aster_api=info,aster_runtime=info,aster_storage=info
# Live-config path for native commands (default ./aster.toml). With Compose the
# server uses data/aster.toml; set this so `aster console` reads the same file.
# ASTER_CONFIG=data/aster.toml
