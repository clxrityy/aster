#!/usr/bin/env bash
# aster-curl [curl options] <url | /path>: curl the API as the owner.
# A path like /v1/runtime is sent to this machine's Aster (see aster-status).
# The token is read from the env file and passed without appearing in `ps`.
# shellcheck source=bin/_lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

args=()
for arg in "$@"; do
    if [[ "$arg" == /* ]]; then
        args+=("$(api_url)$arg")
    else
        args+=("$arg")
    fi
done
token="$(owner_token)"
exec curl \
    -H @<(printf 'Authorization: Bearer %s\n' "$token") \
    -H "Content-Type: application/json" \
    -w '\n' \
    "${args[@]}"
