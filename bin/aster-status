#!/usr/bin/env bash
# aster-status: what is running and how Aster is doing.
# shellcheck source=bin/_lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

echo "mode:  $(aster_mode)"
echo "api:   $(api_url)"
if [[ "$(aster_mode)" != native ]]; then
    compose ps
fi
if curl --silent --fail "$(api_url)/health/live" >/dev/null 2>&1; then
    echo "live:  yes"
    api GET /v1/runtime || true
else
    echo "live:  no"
fi
