# deploy/.env — written by deploy/setup.sh (chmod 600). Never commit it.
# Plain KEY=value lines: Aster's scripts read this file, they never `source` it.

# The dashboard's public hostname (the Cloudflare Tunnel public hostname).
ASTER_HOSTNAME=
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token.
TUNNEL_TOKEN=
# Generated: openssl rand -hex 32
POSTGRES_PASSWORD=
# Generated: openssl rand -hex 32 (sign in to the dashboard with it)
ASTER_OWNER_TOKEN=
# Optional
# ASTER_LOCAL_PORT=8080
# ASTER_FEATURES=neural
# RUST_LOG=aster_api=info,aster_runtime=info,aster_storage=info
